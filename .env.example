# 复制为 .env 并填入密钥（勿提交 .env）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 高德地图 REST Key（地理编码/步行路径/周边搜索）；控制台请配置服务白名单
AMAP_KEY=your_amap_web_service_key_here
# 高德静态地图专用 Key（分享图卫星底图）
AMAP_STATIC_MAP_KEY=your_amap_static_map_key_here
# 前端地图 JS API（index.html 注入，须配置域名白名单）
AMAP_JS_KEY=your_amap_js_key_here
AMAP_JS_SECURITY_CODE=your_amap_js_security_code_here
# 生产环境 CORS（Zeabur 必填，逗号分隔）；留空则开发环境允许 *
# CORS_ORIGINS=https://noomings.com,https://www.noomings.com,https://nooming.github.io,https://www.nooming.github.io
# 高德缓存 TTL（秒）、并发上限
# AMAP_CACHE_TTL_SEC=1800
# AMAP_MAX_CONCURRENT=4
# MAX_ROUTE_WAYPOINTS=5
# 计划游玩时长：后端与 Agent 校验为 30–240 分钟

PORT=5000
FLASK_DEBUG=false
